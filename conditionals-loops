Area Of Circle Java Program
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double r = sc.nextDouble();

        double area = Math.PI * r * r;

        System.out.printf("%.2f", area);
    }
}
